# Bundled app config (loaded at startup by lib/core/env.dart).
# Publishable Supabase keys only — anything sensitive belongs on the backend
# (note: --dart-define values are embedded in the app binary).
# Priority: --dart-define > this file > default.
# Copy this file to `.env` (same directory) for local runs; `.env` is
# gitignored. Without it, Env.load() degrades gracefully to defaults.
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-publishable-anon-key
