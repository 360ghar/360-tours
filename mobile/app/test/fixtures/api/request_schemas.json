          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Icon"
      },
      "icon_color": {
        "anyOf": [
          {
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Icon Color"
      },
      "icon_name": {
        "anyOf": [
          {
            "maxLength": 100,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Icon Name"
      },
      "icon_size": {
        "anyOf": [
          {
            "maximum": 100,
            "minimum": 16,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Icon Size"
      },
      "is_active": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
