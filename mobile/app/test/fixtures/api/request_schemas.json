      }
    },
    "title": "HotspotUpdate",
    "type": "object"
  },
  "PresignedUploadItem": {
    "$defs": {
      "StorageFolderType": {
        "description": "Client folder type for every upload endpoint. Unknown values are a 422.\n\nMaps to the internal StorageFolder in app/services/storage_paths.py.",
        "enum": [
          "avatar",
          "property_image",
          "property_video",
          "property_document",
          "tour_thumbnail",
          "tour_original",
          "scene",
          "document_lease",
          "document_maintenance",
          "document_general",
          "generic"
        ],
        "title": "StorageFolderType",
        "type": "string"
      },
      "TourVisibility": {
        "description": "Tour visibility controls access permissions.\n\n- private: Only the owner can view the tour (requires authentication)\n- unlisted: Anyone with the link can view, but not indexed in public listings\n- public: Visible in public listings and searchable",
        "enum": [
          "private",
          "unlisted",
          "public"
        ],
        "title": "TourVisibility",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "description": "One file to presign. file_size is required and is checked again on confirm.",
    "properties": {
      "content_type": {
        "anyOf": [
          {
            "maxLength": 100,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "MIME type of the file",
        "examples": [
          "image/jpeg"
        ],
        "title": "Content Type"
      },
      "file_size": {
        "description": "File size in bytes",
        "examples": [
          102400
        ],
        "minimum": 0,
        "title": "File Size",
        "type": "integer"
      },
      "filename": {
        "description": "Original filename including extension",
        "examples": [
          "living-room.jpg"
        ],
        "maxLength": 255,
        "minLength": 1,
        "title": "Filename",
        "type": "string"
      },
      "folder_type": {
        "$ref": "#/$defs/StorageFolderType",
        "default": "generic",
        "description": "Storage folder determining the path structure",
        "examples": [
          "property_image"
        ]
      },
      "property_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Required for property_* folder types",
        "examples": [
          1
        ],
        "title": "Property Id"
      },
      "scene_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Required for the scene folder type",
        "examples": [
          "scene_xyz789"
        ],
        "title": "Scene Id"
      },
      "tour_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Required for tour_* and scene folder types",
        "examples": [
          "tour_abc123"
        ],
        "title": "Tour Id"
      },
      "visibility": {
        "$ref": "#/$defs/TourVisibility",
        "default": "private",
        "description": "Media library visibility",
        "examples": [
          "private"
        ]
      }
    },
    "required": [
      "filename",
      "file_size"
    ],
    "title": "PresignedUploadItem",
    "type": "object"
  },
  "PresignedUploadRequest": {
    "$defs": {
      "PresignedUploadItem": {
        "additionalProperties": false,
        "description": "One file to presign. file_size is required and is checked again on confirm.",
        "properties": {
          "content_type": {
            "anyOf": [
              {
                "maxLength": 100,
