{
  "HotspotCreate": {
    "$defs": {
      "AudioContent": {
        "additionalProperties": false,
        "properties": {
          "audio_url": {
            "maxLength": 2048,
            "title": "Audio Url",
            "type": "string"
          },
          "autoplay": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Autoplay"
          },
          "loop": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Loop"
          }
        },
        "required": [
          "audio_url"
        ],
        "title": "AudioContent",
        "type": "object"
      },
      "CustomContent": {
        "additionalProperties": false,
        "properties": {
          "component_key": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Component Key"
          },
          "html": {
            "anyOf": [
              {
                "maxLength": 20000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Html"
          },
          "props": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Props"
          }
        },
        "title": "CustomContent",
        "type": "object"
      },
      "HotspotPosition": {
        "additionalProperties": false,
        "description": "Position of a hotspot on the panorama.",
        "properties": {
          "pitch": {
            "description": "Vertical angle in degrees",
            "maximum": 90,
            "minimum": -90,
            "title": "Pitch",
            "type": "number"
          },
          "radius": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional radius for interaction area",
            "title": "Radius"
          },
          "yaw": {
            "description": "Horizontal angle in degrees",
            "maximum": 180,
            "minimum": -180,
            "title": "Yaw",
            "type": "number"
          }
        },
        "required": [
          "yaw",
          "pitch"
        ],
        "title": "HotspotPosition",
        "type": "object"
      },
      "HotspotType": {
        "enum": [
          "navigation",
          "info",
          "audio",
          "video",
          "link",
          "custom"
        ],
        "title": "HotspotType",
        "type": "string"
      },
      "InfoContent": {
        "additionalProperties": false,
        "properties": {
          "html": {
            "anyOf": [
              {
                "maxLength": 20000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Html"
          },
          "image_url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Image Url"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Text"
          }
        },
        "title": "InfoContent",
        "type": "object"
      },
      "LinkContent": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Label"
          },
          "target": {
            "default": "_blank",
            "enum": [
              "_blank",
              "_self"
            ],
            "title": "Target",
            "type": "string"
          },
          "url": {
            "maxLength": 2048,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "LinkContent",
        "type": "object"
      },
      "NavigationContent": {
        "additionalProperties": false,
        "description": "Navigation hotspots store no content. The target is target_scene_id.",
        "properties": {},
        "title": "NavigationContent",
        "type": "object"
      },
      "VideoContent": {
        "additionalProperties": false,
        "description": "Exactly one of youtube_id, vimeo_id or video_url. A YouTube or Vimeo video_url is normalized to its id.",
        "properties": {
          "autoplay": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Autoplay"
          },
          "loop": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Loop"
          },
          "muted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Muted"
          },
          "poster_url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Poster Url"
          },
          "video_url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Video Url"
          },
          "vimeo_id": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Vimeo Id"
          },
          "youtube_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Youtube Id"
          }
        },
        "title": "VideoContent",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Schema for creating a hotspot. content is validated against type.",
    "properties": {
      "content": {
        "anyOf": [
          {
            "$ref": "#/$defs/NavigationContent"
          },
          {
            "$ref": "#/$defs/LinkContent"
          },
          {
            "$ref": "#/$defs/AudioContent"
          },
          {
            "$ref": "#/$defs/VideoContent"
          },
          {
            "$ref": "#/$defs/InfoContent"
          },
          {
            "$ref": "#/$defs/CustomContent"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Content"
      },
      "custom_data": {
        "additionalProperties": true,
        "title": "Custom Data",
        "type": "object"
      },
      "description": {
        "anyOf": [
          {
            "maxLength": 2000,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Description"
      },
      "icon": {
        "anyOf": [
          {
            "maxLength": 50,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Icon"
      },
      "icon_color": {
        "anyOf": [
          {
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Icon Color"
      },
      "icon_name": {
        "anyOf": [
          {
            "maxLength": 100,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Icon Name"
      },
      "icon_size": {
        "default": 32,
        "maximum": 100,
        "minimum": 16,
        "title": "Icon Size",
        "type": "integer"
      },
      "position": {
        "$ref": "#/$defs/HotspotPosition"
      },
      "target_scene_id": {
        "anyOf": [
          {
            "maxLength": 36,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Target Scene Id"
      },
      "title": {
        "anyOf": [
          {
            "maxLength": 255,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Title"
      },
      "type": {
        "$ref": "#/$defs/HotspotType",
        "default": "info"
      }
    },
    "required": [
      "position"
    ],
    "title": "HotspotCreate",
    "type": "object"
  },
  "HotspotUpdate": {
    "$defs": {
      "HotspotPosition": {
        "additionalProperties": false,
        "description": "Position of a hotspot on the panorama.",
        "properties": {
          "pitch": {
            "description": "Vertical angle in degrees",
            "maximum": 90,
            "minimum": -90,
            "title": "Pitch",
            "type": "number"
          },
          "radius": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional radius for interaction area",
            "title": "Radius"
          },
          "yaw": {
            "description": "Horizontal angle in degrees",
            "maximum": 180,
            "minimum": -180,
            "title": "Yaw",
            "type": "number"
          }
        },
        "required": [
          "yaw",
