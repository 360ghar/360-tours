              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required for property_* folder types",
            "examples": [
              1
            ],
            "title": "Property Id"
          },
          "scene_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required for the scene folder type",
            "examples": [
              "scene_xyz789"
            ],
            "title": "Scene Id"
          },
          "tour_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required for tour_* and scene folder types",
            "examples": [
              "tour_abc123"
            ],
            "title": "Tour Id"
          },
          "visibility": {
            "$ref": "#/$defs/TourVisibility",
            "default": "private",
            "description": "Media library visibility",
            "examples": [
              "private"
            ]
          }
        },
        "required": [
          "filename",
          "file_size"
        ],
        "title": "PresignedUploadItem",
        "type": "object"
      },
      "StorageFolderType": {
        "description": "Client folder type for every upload endpoint. Unknown values are a 422.\n\nMaps to the internal StorageFolder in app/services/storage_paths.py.",
        "enum": [
          "avatar",
          "property_image",
          "property_video",
          "property_document",
          "tour_thumbnail",
          "tour_original",
          "scene",
          "document_lease",
          "document_maintenance",
          "document_general",
          "generic"
        ],
        "title": "StorageFolderType",
        "type": "string"
      },
      "TourVisibility": {
        "description": "Tour visibility controls access permissions.\n\n- private: Only the owner can view the tour (requires authentication)\n- unlisted: Anyone with the link can view, but not indexed in public listings\n- public: Visible in public listings and searchable",
        "enum": [
          "private",
          "unlisted",
          "public"
        ],
        "title": "TourVisibility",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "files": {
        "items": {
          "$ref": "#/$defs/PresignedUploadItem"
        },
        "maxItems": 20,
        "minItems": 1,
        "title": "Files",
        "type": "array"
      }
    },
    "required": [
      "files"
    ],
    "title": "PresignedUploadRequest",
    "type": "object"
  },
  "SceneCreate": {
    "$defs": {
      "SceneCameraSettings": {
        "additionalProperties": false,
        "description": "Camera settings for a scene.",
        "properties": {
          "fov": {
            "anyOf": [
              {
                "maximum": 150,
                "minimum": 10,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": 70,
            "title": "Fov"
          },
          "max_fov": {
            "anyOf": [
              {
                "maximum": 150,
                "minimum": 10,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": 90,
            "title": "Max Fov"
          },
          "min_fov": {
            "anyOf": [
              {
                "maximum": 150,
                "minimum": 10,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": 30,
            "title": "Min Fov"
          }
        },
        "title": "SceneCameraSettings",
        "type": "object"
      },
      "SceneDimensions": {
        "additionalProperties": false,
        "properties": {
          "height": {
            "minimum": 0,
            "title": "Height",
            "type": "integer"
          },
          "width": {
            "minimum": 0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "width",
          "height"
        ],
        "title": "SceneDimensions",
        "type": "object"
      },
      "SceneGps": {
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "maximum": 90,
            "minimum": -90,
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "title": "Longitude",
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "SceneGps",
        "type": "object"
      },
      "SceneInitialView": {
        "additionalProperties": false,
        "description": "Initial camera view for a scene.",
        "properties": {
          "pitch": {
            "default": 0.0,
            "maximum": 90,
            "minimum": -90,
            "title": "Pitch",
            "type": "number"
          },
          "yaw": {
            "default": 0.0,
            "maximum": 180,
            "minimum": -180,
            "title": "Yaw",
            "type": "number"
          },
          "zoom": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": 50,
            "description": "Zoom level from 0 (widest) to 100 (closest), the Photo Sphere Viewer zoomLevel scale.",
            "title": "Zoom"
          }
        },
        "title": "SceneInitialView",
        "type": "object"
      },
      "SceneMetadata": {
        "additionalProperties": false,
